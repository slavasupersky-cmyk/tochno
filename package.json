{
  "name": "tochno",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт агентства недвижимости «ТОЧНО.» — статическая сборка из content.json",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node --run serve",
    "serve": "npx --yes http-server dist -p 8080 -c-1 -o",
    "texts:export": "node texts.js export",
    "texts:rtf": "node texts.js export --rtf",
    "texts:import": "node texts.js import && node build.js",
    "images": "node images.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
